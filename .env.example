# Database
DATABASE_URL=postgresql://ncm_user:ncm_password@localhost:5432/ncm_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Git Storage
GIT_REPO_PATH=./storage/configs

# Application
APP_NAME=NCM Platform
APP_VERSION=1.0.0
DEBUG=True

# Backup Settings
DEFAULT_BACKUP_INTERVAL=3600
MAX_CONCURRENT_BACKUPS=10

# Email/SMTP Settings (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
FROM_EMAIL=noreply@ncm-platform.local

# Webhook Settings
NOTIFICATION_WEBHOOKS=
